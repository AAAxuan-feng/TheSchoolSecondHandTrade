<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml —— 完整版，直接整体覆盖
  路径：app/src/main/AndroidManifest.xml
  （全选 → 删除 → 粘贴本文件全部内容）

  ★ 本文件不使用 Studio 模板那种给每个 Activity 单独起一个标题资源
    （title_activity 开头的那种）的写法，统一用 strings.xml 里已有的 app_name，
    因此不会再出现 "resource string/title_activity_... not found" 这类链接错误。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 (API 33) 及以上：读相册图片 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 (API 32) 及以下：读外部存储 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Glide 常规配置（本地图片其实用不到） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheSchoolSecondHandTrade"
        tools:targetApi="31">

        <!-- ① 登录页：启动页 -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ② 注册页 -->
        <activity
            android:name=".activity.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ③ 首页（商品列表） -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <!-- ④ 发布商品 -->
        <activity
            android:name=".activity.PublishActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ⑤ 商品详情 -->
        <activity
            android:name=".activity.GoodsDetailActivity"
            android:exported="false" />

        <!-- ⑥ 个人中心 -->
        <activity
            android:name=".activity.MineActivity"
            android:exported="false" />

        <!-- ⑦⑧⑨ 我发布的 / 我买到的 / 我卖出的（共用一套布局） -->
        <activity
            android:name=".activity.MyPublishActivity"
            android:exported="false" />
        <activity
            android:name=".activity.MyBuyActivity"
            android:exported="false" />
        <activity
            android:name=".activity.MySellActivity"
            android:exported="false" />

    </application>

</manifest>