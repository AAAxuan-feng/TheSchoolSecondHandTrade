<?xml version="1.0" encoding="utf-8"?>
<!--
  themes.xml (night) —— 位置 app/src/main/res/values-night/themes.xml
  作用：防止手机开深色模式时白色文字变黑/背景变黑导致界面难看。
  如果你项目里没有 values-night 目录，可以跳过这个文件。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TheSchoolSecondHandTrade" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>